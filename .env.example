# =========================
# SkillBridge environment
# =========================
# Copy this file to .env and replace placeholder values.
# NEVER commit .env or real API keys.

# AI / LLM
# "groq" is free (no card required); "gemini" is also free-tier;
# "anthropic" is paid (only a one-time trial credit, no ongoing free tier).
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=postgresql://skillbridge:skillbridge@localhost:5432/skillbridge

# Job data provider
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Judge0 sandbox
JUDGE0_API_URL=

# Frontend -> Backend
NEXT_PUBLIC_API_URL=http://localhost:8000
