# SkillBridge shared environment template
# Copy to .env locally. Never commit .env or real secrets.

# Backend / database
DATABASE_URL=postgresql+psycopg://skillbridge:skillbridge@localhost:5432/skillbridge
JWT_SECRET_KEY=
FRONTEND_URL=http://localhost:3000

# LLM
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# RAG / jobs
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=job_postings
PINECONE_API_KEY=
PINECONE_INDEX_NAME=skillbridge-job-postings
JOB_DATA_PROVIDER=adzuna
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
RAG_TOP_K=5

# Verification
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCKS=false

# Runtime
DEMO_MODE=false
