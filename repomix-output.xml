        <SkillGapSummary diagnosis={diagnosis} />
      ) : mode === 'resume' ? (
        <ResumeUploader onSubmit={(d) => runDiagnosis({ targetRole: d.targetRole, resumeText: d.resumeText })} isLoading={loading} />
