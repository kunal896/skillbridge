# =========================
# SkillBridge Agents Config
# =========================

# Anthropic / Claude API Key
ANTHROPIC_API_KEY=

# LLM Model selection
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Vector Store (chroma | pinecone)
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/chroma
PINECONE_API_KEY=
PINECONE_INDEX_NAME=skillbridge-job-postings

# Job Ingestion Data Provider
JOB_DATA_PROVIDER=adzuna
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Judge0 Execution Sandbox
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=

# Database Connection
DATABASE_URL=postgresql://skillbridge:skillbridge@localhost:5432/skillbridge

# Pipeline parameters
DEFAULT_MAX_RETRIES=2
ROADMAP_LENGTH=6
RAG_TOP_K=5
