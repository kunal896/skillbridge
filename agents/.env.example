# =========================
# SkillBridge Agents Config
# =========================

# Which LLM backend agents/llm_client.py calls. "groq" is free (no card
# required) and is the default; "gemini" is also free-tier; "anthropic" is
# paid (only a small one-time trial credit, no ongoing free tier).
LLM_PROVIDER=groq

# Groq (free tier) -- get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (free tier) -- get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic / Claude (paid) -- only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Vector Store (chroma | pinecone)
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/chroma
PINECONE_API_KEY=
PINECONE_INDEX_NAME=skillbridge-job-postings

# Job Ingestion Data Provider
JOB_DATA_PROVIDER=adzuna
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Judge0 Execution Sandbox
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=

# Database Connection
DATABASE_URL=postgresql://skillbridge:skillbridge@localhost:5432/skillbridge

# Pipeline parameters
DEFAULT_MAX_RETRIES=2
ROADMAP_LENGTH=6
RAG_TOP_K=5
